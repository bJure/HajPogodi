{
  "name": "hajpogodi",
  "version": "0.1.0",
  "private": true,
  "description": "Prognoze rezultata Hajdukovih utakmica",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "next": "^16.0.0",
    "next-auth": "^5.0.0-beta.29",
    "pino": "^9.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "//overrides": [
    "Next 16.2.12 is the newest stable release and still pins postcss 8.4.31 and",
    "sharp 0.34.5, both of which carry high-severity advisories (the fix only exists",
    "on the 16.3 preview line). Both are drop-in compatible minor bumps, so they are",
    "forced here rather than shipping known-vulnerable versions. With them in place",
    "`npm audit --omit=dev` reports nothing, which is what CI blocks on.",
    "Remove these once a stable Next ships the patched versions itself."
  ],
  "overrides": {
    "postcss": "^8.5.24",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
