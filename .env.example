# Predlozak konfiguracije. Kopiraj u .env i popuni.
#
# NIJEDNA vrijednost ovdje nije upotrebljiva namjerno - aplikacija odbija
# pokretanje dok ih ne zamijenis. Ovaj predlozak je javan, pa bi svaka
# vrijednost koja bi prosla validaciju bila javno poznata tajna.

# --- Baza ---------------------------------------------------------------
# Lokalno, uz `docker compose up -d` (baza slusa samo na 127.0.0.1):
DATABASE_URL="postgresql://hajpogodi:hajpogodi@localhost:5432/hajpogodi?schema=public"
# Produkcija (Neon, obavezno ?sslmode=require):
# DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/hajpogodi?sslmode=require"

# --- Auth ---------------------------------------------------------------
# Generiraj: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Puni URL aplikacije. OBAVEZAN u produkciji: bez njega Host zaglavlje odreduje
# callback URL-ove, pa aplikacija odbija start. Npr. https://hajpogodi.vercel.app
AUTH_URL="http://localhost:3000"

# --- Prvi admin (koristi se samo u seedu) --------------------------------
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_NICKNAME="Admin"
# Smisli svoju. Seed odbija poznate placeholdere i lozinke krace od 12 znakova.
# Prijedlog: node -e "console.log(require('node:crypto').randomBytes(12).toString('base64url'))"
SEED_ADMIN_PASSWORD=""

# --- Cron ---------------------------------------------------------------
# Zajednicka tajna izmedu GitHub Actions / Cloudflare Workera i /api/cron/tick.
# Generiraj: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# --- API-Football (https://dashboard.api-football.com) -------------------
# Bez kljuca nema automatske sinkronizacije; utakmice se unose rucno.
# Besplatni plan: 100 zahtjeva dnevno - vise nego dovoljno za 2 utakmice tjedno.
API_FOOTBALL_KEY=""
# Hajduk Split, ID tima u API-Football bazi
API_FOOTBALL_TEAM_ID="620"

# --- Roast engine (opcionalno) ------------------------------------------
# Ako je prazno, koristi se deterministicki generator (radi bez interneta i bez troska)
ANTHROPIC_API_KEY=""

# --- Ostalo -------------------------------------------------------------
LOG_LEVEL="info"
TZ="Europe/Zagreb"
